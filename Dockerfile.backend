FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend \
    DATA_DIR=/data \
    FRONTEND_BUILD_DIR=/app/frontend

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libmagic1 \
        pandoc \
    && rm -rf /var/lib/apt/lists/*

# Keep every dependency manifest in this layer so dependency changes invalidate it.
COPY pyproject.toml uv.lock backend/requirements.txt /tmp/dependencies/
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r /tmp/dependencies/requirements.txt

COPY package.json CHANGELOG.md /app/
COPY backend /app/backend

RUN mkdir -p /data

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5)"

CMD ["python", "-m", "uvicorn", "open_webui.main:app", "--host", "0.0.0.0", "--port", "8080", "--forwarded-allow-ips=*"]
