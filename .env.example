# Docker Compose host paths and published ports.
# Keep SYNBIO_DATA_DIR on persistent storage; it contains webui.db and uploads.
SYNBIO_DATA_DIR='./backend/data'
MEDCPT_MODEL_DIR='/qiannanhu01/models/MedCPT'
SPECTER2_MODEL_DIR='/qiannanhu01_nfs/models/SPECTER2'
SPECTER2_PMID_MAPPING_DB='/qiannanhu01_nfs/synbiogpt/data/id_mapping/pmid_pmcid_full.sqlite3'
SYNBIO_PORT=8080
SYNBIO_DEV_PORT=5173

# When these services run on the Docker host, use host.docker.internal rather
# than 127.0.0.1. For remote services, use their reachable IP or DNS name.
QDRANT_URI='http://host.docker.internal:6333'
OPENSEARCH_URI='http://host.docker.internal:9200'

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL='http://host.docker.internal:8000/v1'
OPENAI_API_KEY=''
OPENAI_MODEL=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Full-text MedCPT + BM25 indexing
# Normal user chats retrieve from this application-level knowledge base by default.
# SYNBIO_DEFAULT_KNOWLEDGE_ENABLED=true
# SYNBIO_DEFAULT_COLLECTION='fulltext_medcpt_ip_v1'
# MEDCPT_ARTICLE_ENCODER='/path/to/MedCPT/Article-Encoder'
# MEDCPT_QUERY_ENCODER_MODEL='/qiannanhu01_nfs/models/MedCPT/Query-Encoder'
# MEDCPT_QUERY_ENCODER_COLLECTIONS='fulltext_medcpt_ip_v1'
# MEDCPT_QUERY_ENCODER_DEVICE='cuda:0'
